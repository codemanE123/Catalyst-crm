# Required for normal signed-in app use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — canonical app URL for invite links (Production).
# Example: https://catalyst-crm-tau.vercel.app
# NEXT_PUBLIC_APP_URL=

# Not required for normal app use. Reserve for future background jobs only.
# Do not set for routine local dashboard testing.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — error monitoring (Phase 2 Task 2.32). Omit locally unless testing Sentry.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_ENABLE_TEST_ROUTE=true
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Optional — College Scorecard prospect discovery (Phase 5.2).
# Disabled or missing key returns a safe configuration result in staging/production.
# Deterministic stub fallback is development-only (never silent mock in staging/prod).
# COLLEGE_SCORECARD_ENABLED=true
# COLLEGE_SCORECARD_API_KEY=
# DATA_GOV_API_KEY=
# COLLEGE_SCORECARD_TIMEOUT_MS=12000
# COLLEGE_SCORECARD_MAX_PAGES=5
# COLLEGE_SCORECARD_MAX_RETRIES=2
# COLLEGE_SCORECARD_MIN_REQUEST_INTERVAL_MS=250
# COLLEGE_SCORECARD_ALLOW_STUB=false

# Optional — Public web prospect discovery (Phase 5.2.1). Disabled by default.
# Uses Google Programmable Search (Custom Search JSON API) — does not scrape SERP HTML.
# Runs in the agent worker after College Scorecard when more candidates are needed.
# PUBLIC_WEB_DISCOVERY_ENABLED=false
# WEB_SEARCH_PROVIDER=google_cse
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_ENGINE_ID=
# PUBLIC_WEB_ALLOWED_DOMAIN_SUFFIXES=.edu,.gov
# PUBLIC_WEB_MAX_SCHOOLS_PER_JOB=10
# PUBLIC_WEB_MAX_PAGES_PER_SCHOOL=3
# PUBLIC_WEB_FETCH_TIMEOUT_MS=4000
# PUBLIC_WEB_MAX_RESPONSE_BYTES=500000
# PUBLIC_WEB_USER_AGENT=CatalystCRMProspectBot/1.0 (+https://catalyst-crm.local; research)
# PUBLIC_WEB_REQUIRE_ROBOTS_ALLOWED=true

# Optional — Fireflies meeting import (Phase 5.x.1). Disabled by default.
# Webhook: POST /api/integrations/fireflies/webhook (shared secret required).
# Imports stay pending_review until Accept creates discovery interview notes.
# MEETING_IMPORT_ENABLED=false
# MEETING_IMPORT_REQUIRE_REVIEW=true
# FIREFLIES_WEBHOOK_SECRET=
# FIREFLIES_API_KEY=
# FIREFLIES_DEFAULT_ORGANIZATION_ID=

# Optional — OpenAI LLM enrichment + outreach drafts (Phase 5.3).
# Disabled by default. When enabled, uses the shared LLM abstraction + production gates
# (policy model, readiness, budgets, prompt/rollout stamps). No second provider framework.
# LLM_ENRICHMENT_ENABLED=false
# OPENAI_API_KEY=
# Approved models come from active policy default_model (gpt-4o-mini | gpt-4o | gpt-4.1-mini).

# Optional — automated agent worker (Phase 4.7).
# Required on Vercel for /api/agents/process cron. Keep secret out of client code.
# AGENT_CRON_SECRET=
# Uses service role only for the cron worker (bypasses RLS to claim jobs across orgs).
# SUPABASE_SERVICE_ROLE_KEY=
# AGENT_WORKER_BATCH_SIZE=5
# AGENT_MAX_ATTEMPTS=3

# Optional — agent cost, usage, and safety limits (Phase 4.8). Safe defaults apply when unset.
# AGENT_FEATURE_ENABLED=true
# AGENT_MAX_EXECUTIONS_PER_HOUR=60
# LLM_MAX_CALLS_PER_DAY=200
# LLM_DAILY_BUDGET_USD=25
# LLM_MONTHLY_BUDGET_USD=250
# AGENT_MAX_CONCURRENT_EXECUTIONS=5
# AGENT_MAX_CANDIDATE_BATCH_SIZE=50
# AGENT_MAX_CHAIN_DEPTH=5
# AGENT_MAX_PROMPT_CHARS=24000
# AGENT_MAX_OUTPUT_CHARS=8000

# Optional — agent quality evaluation (Phase 4.10). Safe defaults apply when unset.
# AGENT_QUALITY_LOW_SCORE_THRESHOLD=2.5
# AGENT_QUALITY_ALERT_REJECTION_RATE=0.4
# AGENT_REQUIRE_SOURCE_CITATIONS=true
# AGENT_MIN_SAFETY_SCORE=3
# AGENT_EVALUATION_FEEDBACK_MAX_LENGTH=500

# Optional — prompt versioning and rollouts (Phase 4.11). Safe defaults apply when unset.
# AGENT_PROMPT_MAX_TEMPLATE_CHARS=24000
# AGENT_PROMPT_MAX_OUTPUT_TOKENS=4000
# AGENT_ROLLOUT_DEFAULT_PERCENTAGE=0
# AGENT_ROLLOUT_ASSIGNMENT_KEY=organization_id
# AGENT_PROMPT_REQUIRE_SAFETY_POLICY=true
# AGENT_PROMPT_REQUIRE_SCHEMA_VERSION=true
# AGENT_PROMPT_ACTIVATION_MIN_QUALITY=3

# Optional — agent policy management console (Phase 4.12). Safe defaults apply when unset.
# Env is bootstrap only; stricter DB safety policies are not silently loosened by env.
# AGENT_POLICY_MANAGEMENT_ENABLED=true
# AGENT_POLICY_DEFAULT_DAILY_BUDGET_USD=25
# AGENT_POLICY_DEFAULT_MONTHLY_BUDGET_USD=250
# AGENT_POLICY_DEFAULT_MAX_CONCURRENCY=5
# AGENT_POLICY_BREAK_GLASS_MAX_HOURS=24
# AGENT_POLICY_REQUIRE_APPROVAL=true
# AGENT_POLICY_REQUIRE_SOURCE_CITATIONS=true

# Optional — agent readiness certification / production launch gate (Phase 4.14).
# Safe defaults: enabled, production required, staging not required.
# AGENT_READINESS_ENABLED=true
# AGENT_READINESS_PRODUCTION_REQUIRED=true
# AGENT_READINESS_STAGING_REQUIRED=false
# AGENT_READINESS_PRODUCTION_EXPIRY_DAYS=30
# AGENT_READINESS_STAGING_EXPIRY_DAYS=14
# AGENT_READINESS_MAX_SIMULATION_AGE_HOURS=168
# AGENT_READINESS_REQUIRE_SEPARATION_OF_DUTIES=true
# AGENT_READINESS_MIN_QUALITY_SCORE=3
# AGENT_READINESS_MIN_SAFETY_SCORE=3
# AGENT_READINESS_ENVIRONMENT=staging
